# Copy to .env and adjust. No API key belongs here or anywhere else on the
# server: callers supply their own OpenAI key per request via the
# X-OpenAI-Key header.

# Sent bare; namespaced automatically for providers that require it, so
# OpenRouter receives openai/gpt-5.1.
SMARTANALYST_OPENAI_MODEL=gpt-5.1

# JSON array. Set to the deployed frontend origin in production.
SMARTANALYST_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SMARTANALYST_MAX_UPLOAD_BYTES=10485760
SMARTANALYST_MAX_ROWS=200000
SMARTANALYST_SESSION_TTL_SECONDS=1800
SMARTANALYST_MAX_SESSIONS=25
SMARTANALYST_QUERY_TIMEOUT_SECONDS=15
SMARTANALYST_DEFAULT_ROW_LIMIT=5000
